# Trino connection
TRINO_URL=http://trino1:8080
TRINO_USER=log_search
TRINO_PASSWORD=

# Trino catalog and tables
TRINO_CATALOG=iceberg
TRINO_SCHEMA=logs
TRINO_SYSLOG_TABLE=syslog_events
TRINO_AUTHLOG_TABLE=authlog_events
TRINO_TIMESTAMP_COLUMN=ts
TRINO_TIMESTAMP_EXPRESSION=

# Docker Compose extra_hosts entry
TRINO_HOST_ALIAS=trino1
TRINO_HOST_IP=192.168.11.18

# Access log
ACCESS_LOG_HOST=trino-host
ACCESS_LOG_RETENTION_DAYS=14
